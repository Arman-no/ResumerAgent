# Directory containing Claude Code's "sessions" and "projects" folders.
# Defaults to $CLAUDE_CONFIG_DIR, then ~/.claude, if unset.
# SESSIONS_ROOT=C:\path\to\.claude

# Command templates used to resume/attach a session.
# Placeholders: {cwd}, {sessionId}, {id}
# {cwd} is inserted already quoted for the shell/cmd it will run in — don't
# add your own quotes around it.
# Defaults below match a native Claude Code install with `claude` on PATH.
# RESUME_COMMAND=claude --resume {sessionId}
# ATTACH_COMMAND=claude attach {id}

# Port for the local dashboard server.
# PORT=4317

# Override how Resume/Attach opens a terminal window, when the built-in
# default for your OS (cmd.exe on Windows, Terminal.app on macOS, the first
# installed terminal emulator on Linux) doesn't fit — e.g. a Linux box with
# none of the auto-detected emulators, or you just prefer a specific one.
# Placeholders: {command}, {title}, {cwd}
# {cwd} is inserted already quoted (as in the example below) — don't add
# your own quotes around it.
# TERMINAL_COMMAND=gnome-terminal --title={title} -- bash -c "cd {cwd} && {command}; exec bash"
